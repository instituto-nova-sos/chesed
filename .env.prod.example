# =============================================================================
# Chesed Production Environment Variables
# =============================================================================
# Copy this file to .env.prod and fill in all values.
# NEVER commit .env.prod — it contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=chesed
POSTGRES_PASSWORD=<generate-strong-password>
POSTGRES_DB=chesed

# -----------------------------------------------------------------------------
# Keycloak
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<generate-strong-password>

# Hostname must match the public URL where Keycloak is reachable.
# When behind nginx reverse proxy at /auth/, set to the public domain.
KC_HOSTNAME=https://yourdomain.org/auth

# -----------------------------------------------------------------------------
# SMTP (Keycloak email: verification, password reset, MFA codes)
# -----------------------------------------------------------------------------
# Examples: SendGrid (smtp.sendgrid.net:587), AWS SES, Mailgun
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_FROM=noreply@institutanovasos.org
SMTP_FROM_DISPLAY_NAME=Instituto Nova SOS
SMTP_USER=apikey
SMTP_PASSWORD=<smtp-api-key-or-password>
SMTP_STARTTLS=true
SMTP_SSL=false

# -----------------------------------------------------------------------------
# Go API
# -----------------------------------------------------------------------------
SERVER_PORT=8080
DATABASE_URL=postgres://chesed:${POSTGRES_PASSWORD}@db:5432/chesed?sslmode=disable
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=chesed
KEYCLOAK_CLIENT_ID=chesed-pwa
LOG_LEVEL=info
# MUST be false in production — enables strict OIDC issuer validation
OIDC_SKIP_ISSUER_CHECK=false

# -----------------------------------------------------------------------------
# Frontend (build-time variables, baked into static bundle)
# -----------------------------------------------------------------------------
# These must match the public-facing URLs (what the browser sees)
VITE_KEYCLOAK_URL=https://yourdomain.org/auth
VITE_KEYCLOAK_REALM=chesed
VITE_KEYCLOAK_CLIENT_ID=chesed-pwa
VITE_API_BASE_URL=https://yourdomain.org/api/v1
