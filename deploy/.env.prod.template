# =============================================================================
# Chesed — Production Environment Template (.env.prod)
# =============================================================================
# Copy this file to the repository root as `.env.prod` on the production server
# and fill in every value. This template is a SUPERSET of `.env.prod.example`:
# it documents the same variables PLUS the new Sprint 11 public-API variables
# (PUBLIC_CORS_ORIGINS, HSTS_ENABLED, PUBLIC_RATE_LIMIT_RPM) and the object
# storage credentials the API requires to boot.
#
# RULES (see docs/19-secure-development-standard.md):
#   - NEVER commit `.env.prod`. It contains secrets. Only this template is
#     version-controlled, and it MUST contain placeholders only — no real
#     secrets, keys, or passwords.
#   - Generate every password/secret with a strong generator, e.g.:
#         openssl rand -base64 32
#   - `.env.prod` is consumed by:
#         docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#     and sourced by scripts/deploy.sh and scripts/init-letsencrypt.sh.
#
# Deployment runbook:  docs/runbooks/production-deployment.md
# Deployment strategy: docs/14-deployment-strategy.md
# =============================================================================


# -----------------------------------------------------------------------------
# 1. TLS / Domain (used by scripts/init-letsencrypt.sh and scripts/deploy.sh)
# -----------------------------------------------------------------------------
# DOMAIN_NAME is the single public hostname. Certbot requests one certificate
# for it (cert-name "chesed"). DNS A/AAAA records must already point here before
# the first deploy or the ACME HTTP-01 challenge will fail.
DOMAIN_NAME=chesed.yourdomain.org

# Contact address Let's Encrypt uses for expiry notices. Must be a real inbox.
CERTBOT_EMAIL=admin@yourdomain.org


# -----------------------------------------------------------------------------
# 2. PostgreSQL (service: db)
# -----------------------------------------------------------------------------
# Owner role. Owns the schema; migrations run as this role and bypass RLS.
POSTGRES_USER=chesed
POSTGRES_PASSWORD=<generate-strong-password>
POSTGRES_DB=chesed

# Non-owner RLS application login role `chesed_app` (Sprint 9.1, Model A).
# The running API connects as this role so PostgreSQL row-level security
# applies. Created by docker/postgres/init-app-role.sh at first DB init from
# this value. MUST be set in production — do NOT rely on the dev default
# ("chesed_app"). This is one of the four Sprint 11 checklist secrets.
POSTGRES_APP_PASSWORD=<generate-strong-password>


# -----------------------------------------------------------------------------
# 3. Keycloak (service: keycloak — image quay.io/keycloak/keycloak:26.0)
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<generate-strong-password>

# Public URL where Keycloak is reachable. Behind the nginx reverse proxy this
# is the public domain plus the /auth path. Must match VITE_KEYCLOAK_URL below.
KC_HOSTNAME=https://yourdomain.org/auth


# -----------------------------------------------------------------------------
# 4. SMTP (Keycloak-owned email: verification, password reset, MFA codes)
# -----------------------------------------------------------------------------
# Wired into Keycloak via KC_SPI_EMAIL_SENDER_DEFAULT_* in
# docker-compose.prod.yml. Keycloak owns ALL transactional email — there is no
# application-side mail code. Provider examples: SendGrid (smtp.sendgrid.net:587),
# AWS SES, Mailgun. See docs/runbooks/password-recovery-verification.md.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_FROM=noreply@institutanovasos.org
SMTP_FROM_DISPLAY_NAME=Instituto Nova SOS
SMTP_USER=apikey
SMTP_PASSWORD=<smtp-api-key-or-password>
# STARTTLS on 587, SSL on 465 — set exactly one to true.
SMTP_STARTTLS=true
SMTP_SSL=false


# -----------------------------------------------------------------------------
# 5. Go API (service: api)
# -----------------------------------------------------------------------------
SERVER_PORT=8080

# Owner connection string. Used by the `migrate` one-shot service (migrations
# must run as owner to bypass RLS) and by the API's ADMIN_DATABASE_URL for
# pre-campus BypassRLS routes (self-register, onboarding lookup).
# sslmode: use "require" when the DB enforces TLS; "disable" only inside the
# private compose network (chesed-internal) where traffic never leaves the host.
DATABASE_URL=postgres://chesed:${POSTGRES_PASSWORD}@db:5432/chesed?sslmode=disable

# Non-owner connection string. The API's primary DATABASE_URL is set from this
# so the app is subject to RLS. Uses the chesed_app role + POSTGRES_APP_PASSWORD.
APP_DATABASE_URL=postgres://chesed_app:${POSTGRES_APP_PASSWORD}@db:5432/chesed?sslmode=disable

# Internal service URL — the API reaches Keycloak over the compose network.
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=chesed
KEYCLOAK_CLIENT_ID=chesed-pwa

LOG_LEVEL=info
# MUST be false in production — enables strict OIDC issuer validation.
OIDC_SKIP_ISSUER_CHECK=false


# -----------------------------------------------------------------------------
# 6. Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO)
# -----------------------------------------------------------------------------
# The API validates these at boot (config.go: S3AccessKey/S3SecretKey are
# `required`). The API will NOT start if the credentials are missing. Inject
# them into the `api` service environment (extend docker-compose.prod.yml's
# api.environment, or set them in a compose override).
S3_ENDPOINT=s3.amazonaws.com
S3_BUCKET=chesed-docs-prod
S3_ACCESS_KEY=<object-storage-access-key>
S3_SECRET_KEY=<object-storage-secret-key>
# true for managed cloud storage (S3/R2); false only for in-network MinIO.
S3_USE_SSL=true


# -----------------------------------------------------------------------------
# 7. Public API surface — CORS / HSTS / rate limit  (NEW in Sprint 11)
# -----------------------------------------------------------------------------
# These govern the public (unauthenticated) API surface consumed by the
# WordPress marketing site. They supersede the single-origin dev default
# (middleware.CORS("http://localhost:5173")) and the legacy CORS_ORIGINS /
# RATE_LIMIT_* names in docs/14. Set all three explicitly in production.

# Comma-separated allowlist of browser Origins permitted to call the public
# API (the WordPress site origin(s)). Exact-match, no wildcards. Example:
#   PUBLIC_CORS_ORIGINS=https://institutanovasos.org,https://www.institutanovasos.org
PUBLIC_CORS_ORIGINS=https://yourdomain.org

# Enable HTTP Strict Transport Security. MUST be true in production so browsers
# pin HTTPS for the domain. Leave false only for local/staging over plain HTTP.
HSTS_ENABLED=true

# Per-origin rate limit for the public API, in requests per minute. Throttles
# the WordPress-facing endpoints to blunt scraping / abuse.
PUBLIC_RATE_LIMIT_RPM=60


# -----------------------------------------------------------------------------
# 8. Frontend (service: frontend — build-time args, baked into the static bundle)
# -----------------------------------------------------------------------------
# These are compiled into the JS bundle at image build time, so they must be
# the PUBLIC-facing URLs the browser will see (not internal service names).
# Changing them requires rebuilding the frontend image.
VITE_KEYCLOAK_URL=https://yourdomain.org/auth
VITE_KEYCLOAK_REALM=chesed
VITE_KEYCLOAK_CLIENT_ID=chesed-pwa
VITE_API_BASE_URL=https://yourdomain.org/api/v1
