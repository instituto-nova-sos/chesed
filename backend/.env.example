# Server
SERVER_PORT=8080

# Database — the running app connects as the non-owner RLS role chesed_app
# (Sprint 9.1). Migrations run as owner `chesed` via the Makefile MIGRATE_URL.
DATABASE_URL=postgres://chesed_app:chesed_app@localhost:5432/chesed?sslmode=disable

# Keycloak
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=chesed
KEYCLOAK_CLIENT_ID=chesed-pwa

# Logging
LOG_LEVEL=debug
