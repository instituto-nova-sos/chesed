# PostgreSQL
POSTGRES_USER=chesed
POSTGRES_PASSWORD=chesed
POSTGRES_DB=chesed

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Go API
SERVER_PORT=8080
