# PostgreSQL
POSTGRES_USER=chesed
POSTGRES_PASSWORD=chesed
POSTGRES_DB=chesed
# Password for the non-owner RLS app role chesed_app (Sprint 9.1, Model A).
POSTGRES_APP_PASSWORD=chesed_app

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Go API
SERVER_PORT=8080
# The running app connects as the non-owner role chesed_app so PostgreSQL RLS
# applies. Migrations run as owner `chesed` (see backend Makefile MIGRATE_URL).
DATABASE_URL=postgres://chesed_app:chesed_app@db:5432/chesed?sslmode=disable
# Owner connection for pre-campus routes (self-register, onboarding lookup) that
# must bypass RLS. Defaults to DATABASE_URL when unset (single-role dev only).
ADMIN_DATABASE_URL=postgres://chesed:chesed@db:5432/chesed?sslmode=disable
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=chesed
KEYCLOAK_CLIENT_ID=chesed-pwa
OIDC_SKIP_ISSUER_CHECK=true
LOG_LEVEL=debug

# SMTP (Production — dev uses Mailpit via init-realm.sh)
# KC_SMTP_HOST=smtp.sendgrid.net
# KC_SMTP_PORT=587
# KC_SMTP_FROM=noreply@institutanovasos.org
# KC_SMTP_FROM_DISPLAY_NAME=Instituto Nova SOS
# KC_SMTP_USER=<from-secrets-manager>
# KC_SMTP_PASSWORD=<from-secrets-manager>
# KC_SMTP_STARTTLS=true

# React Frontend
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=chesed
VITE_KEYCLOAK_CLIENT_ID=chesed-pwa
VITE_API_BASE_URL=http://localhost:8080/api/v1
